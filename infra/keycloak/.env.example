# Environment for infra/keycloak/docker-compose.yml (set in Dokploy, not committed).

# Bootstrap admin (only used when the master realm does not exist yet)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# Database: the Dokploy Postgres service for Keycloak
KC_DB=postgres
KC_DB_URL_HOST=<dokploy-postgres-app-name>
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_SCHEMA=public
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=REPLACE_ME_WITH_STRONG_PASSWORD

# Public URL; Traefik terminates TLS and forwards X-Forwarded-* headers
KC_HOSTNAME=https://keycloak.badgehub.eu
KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true

KC_METRICS_ENABLED=true
KC_HEALTH_ENABLED=true
KC_LOG_LEVEL=WARN
QUARKUS_TRANSACTION_MANAGER_ENABLE_RECOVERY=true
